# Settings for the production stack (compose.prod.yaml). On the box:
#   cp env.example .env && chmod 600 .env    then fill it in
# Never commit the filled-in copy. Docker Compose reads this file twice: to fill the
# ${...} placeholders in compose.prod.yaml, and as the API container's environment.
#
# Don't set NODE_ENV, HOST, PORT, STATIC_DIR or GIT_SHA here: the image sets them. A
# GIT_SHA here would make /healthz report the wrong commit and every deploy would fail.
# Write values without quotes.

# ---- Which image runs ----------------------------------------------------------------
# Where the deploy workflow pushes the image.
IMAGE=ghcr.io/signioratif/tasks
# The image tag, which is the git commit SHA. deploy.sh rewrites this line after each
# successful deploy; leave it empty before the first one.
TAG=

# ---- Caddy -----------------------------------------------------------------------------
# The public hostname. Caddy gets an HTTPS certificate for it automatically.
# On a laptop: http://localhost (plain HTTP, no certificate).
SITE_ADDRESS=tasks.ahmedatif.in
# The host ports Caddy listens on. On a laptop where 80/443 are taken, use e.g. 8080/8443.
HTTP_PORT=80
HTTPS_PORT=443

# ---- Postgres --------------------------------------------------------------------------
# Generate with `openssl rand -hex 32` (hex, so it's safe inside DATABASE_URL as is).
# Postgres reads it only when it creates the database on the very first start; editing it
# later doesn't change the real password.
POSTGRES_PASSWORD=
# The same password again. `db` is the database container's name on the private network.
DATABASE_URL=postgres://tasks:PASTE_POSTGRES_PASSWORD_HERE@db:5432/tasks

# ---- API -------------------------------------------------------------------------------
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# The origin the browser sees. On a laptop: http://localhost, plus the port if HTTP_PORT
# isn't 80 (http://localhost:8080).
BETTER_AUTH_URL=https://tasks.ahmedatif.in
# Signs session cookies. Generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# The Google OAuth client (deploy/README.md, step 1).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Who may sign in, comma-separated.
AUTH_ALLOWED_EMAILS=you@example.com
