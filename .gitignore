# Local agent/tooling state
.claude-flow/
.swarm/
*.rvf
*.rvf.lock
ruvector.db

# OS / editor
.DS_Store
.vscode/
.idea/

# Personal learning vault (Obsidian). The notes are shared, and so is the look:
# the CSS snippets (text width, diagram fit), the themes, and the file that
# turns them on. Obsidian's per-machine state (open tabs, graph zoom, plugins
# and the connector's reading history) stays local.
vault/tools/__pycache__/
vault/.trash/
vault/.obsidian/*
!vault/.obsidian/appearance.json
!vault/.obsidian/snippets/
!vault/.obsidian/themes/

# Planning notes kept local: the decision log and the critique of the brainstorm
docs/brainstorm/00-overview.md
docs/brainstorm/99-critique.md

# Dependencies and build output
node_modules/
dist/
coverage/
# Playwright's results and traces (e2e/)
test-results/
playwright-report/
*.tsbuildinfo

# Local environment (secrets never get committed)
.env
.env.*
!.env.example

# Personal data (the real timetable, seeds): never committed, the repo is public
private/
