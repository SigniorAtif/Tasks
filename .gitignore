# Local agent/tooling state
.claude-flow/
.swarm/
*.rvf
*.rvf.lock
ruvector.db

# OS / editor
.DS_Store
.vscode/
.idea/

# Personal learning vault (Obsidian). The notes are shared, and so is the look:
# the CSS snippets (text width, diagram fit), the themes, and the file that
# turns them on. Obsidian's per-machine state (open tabs, graph zoom, plugins
# and the connector's reading history) and the old session handoffs stay local.
vault/handoffs/
vault/tools/__pycache__/
vault/.trash/
vault/.obsidian/*
!vault/.obsidian/appearance.json
!vault/.obsidian/snippets/
!vault/.obsidian/themes/

# Dependencies and build output
node_modules/
dist/
coverage/
*.tsbuildinfo

# Local environment (secrets never get committed)
.env
.env.*
!.env.example

# Personal data (the real timetable, seeds): never committed, the repo is public
private/
