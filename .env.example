# Copy to `.env` (git-ignored) and fill in what you need. The API reads and checks
# every variable once at start-up (apps/api/src/env.ts); a missing or malformed one
# stops it with a message naming the variable. Empty values count as unset.
#
# In development every variable has a default, so a fresh clone runs without a .env.
# In production the ones marked "required in production" must be set.

# development | test | production
NODE_ENV=development
# Where the API listens. 127.0.0.1 keeps it off your LAN; the Docker image sets 0.0.0.0.
HOST=127.0.0.1
PORT=3000
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Postgres. The default matches compose.yaml (`docker compose up -d db`).
# Required in production.
DATABASE_URL=postgres://tasks:tasks@localhost:5432/tasks
# The integration tests create, migrate and wipe this database. Never point it at real data.
TEST_DATABASE_URL=postgres://tasks:tasks@localhost:5432/tasks_test

# The origin the browser sees. Locally that's Vite's dev server, which forwards /api
# and /healthz to the API; in production it's https://tasks.ahmedatif.in.
# Required in production.
BETTER_AUTH_URL=http://localhost:5173
# Signs session cookies. 32+ random characters: `openssl rand -base64 32`.
# Development falls back to a fixed, public value that production refuses.
# Required in production.
BETTER_AUTH_SECRET=

# Google OAuth client (Google Cloud console → APIs & Services → Credentials).
# Authorised redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
# Optional in development: without them, the sign-in button says Google isn't set up.
# Required in production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails allowed to sign in (D-016: an allowlist of one).
# Anyone else is turned away before a user row is created. Required in production.
AUTH_ALLOWED_EMAILS=you@example.com

# The git commit shown by /healthz. The Docker build sets it; defaults to `dev`.
GIT_SHA=dev
# Folder of the built PWA for the API to serve. Leave unset in development, where
# Vite serves the PWA; the Docker image sets it.
STATIC_DIR=
